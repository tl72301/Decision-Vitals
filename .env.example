# Decision Vitals — environment variables.
# Copy the names, not this file: set these in Vercel (Settings → Environment
# Variables, Production scope), then redeploy. Vercel does not apply new
# variables to an existing build.
#
# Never commit real values. See docs/self-hosting.md for the full walkthrough.

# --- Required ---------------------------------------------------------------

# Your Claude API key, from console.anthropic.com. Read only on the server;
# it never reaches a browser. Agent runs bill to this key.
ANTHROPIC_API_KEY=

# Unlocks Live Mode and gates the MCP endpoint. Generate a random string --
# this travels in a URL, so treat it as a bearer token, and never reuse a
# password you use anywhere else.
LIVE_MODE_PASSPHRASE=

# --- Optional: storage ------------------------------------------------------
# Add the Upstash for Redis integration in Vercel and these are injected for
# you. Needed for the MCP server, cross-decision memory, and Gmail pull --
# each of those runs without a browser tab, so it needs server-side storage.

KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Optional: Gmail ingestion ----------------------------------------------
# From a Google Cloud OAuth client of type "Web application" whose authorized
# redirect URI is exactly https://<your-site>/api/gmail-auth
# Scope requested is gmail.readonly.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Captured once by visiting /api/gmail-auth?key=<LIVE_MODE_PASSPHRASE>
GOOGLE_REFRESH_TOKEN=

# Label to ingest. Defaults to decision-evidence when unset.
# GMAIL_LABEL=decision-evidence
